[Unit]
Description=API de Tarefas (Flask + SQLite via gunicorn)
After=network.target

[Service]
User=azureuser
WorkingDirectory=/opt/api-tarefas
Environment=DB_PATH=/var/lib/api-tarefas/tarefas.db
# cria /var/lib/api-tarefas com dono azureuser (onde fica o arquivo .db)
StateDirectory=api-tarefas
ExecStart=/opt/api-tarefas/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:80 app:app
# permite ouvir na porta 80 sem rodar como root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
